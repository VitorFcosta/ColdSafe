# Aplicação
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
AUTH_JWT_SECRET=

# RabbitMQ: senhas distintas, aleatorias, pelo menos 32 caracteres; sem guest.
RABBITMQ_GATEWAY_PASSWORD=
RABBITMQ_WRITER_PASSWORD=
RABBITMQ_INFERENCE_PASSWORD=
RABBITMQ_DELIVERY_PASSWORD=
RABBITMQ_COMMANDS_PASSWORD=
RABBITMQ_GENERATION_PASSWORD=
RABBITMQ_TRAINING_PASSWORD=
RABBITMQ_OBSERVABILITY_PASSWORD=
RABBITMQ_API_PASSWORD=
RABBITMQ_AUDIT_PASSWORD=

# MQTT
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=coldsafe/v1/telemetry
MQTT_QOS=1
MQTT_CLIENT_ID=coldsafe-backend
MQTT_BACKEND_USERNAME=coldsafe-backend
MQTT_BACKEND_PASSWORD=
MQTT_DEVICE_USERNAME=coldsafe-device
MQTT_DEVICE_PASSWORD=
MQTT_DEVICE_02_USERNAME=coldsafe-device-02
MQTT_DEVICE_02_PASSWORD=

# Gateway v3 (perfil aiot; proprietário já cadastrado no PostgreSQL)
MQTT_GATEWAY_PASSWORD=
GATEWAY_OWNER_USER_ID=

# Simulador B2-09 (perfil opcional; não usa credenciais do ESP32)
MQTT_SIMULATOR_PASSWORD=
MQTT_SIMULATOR_OPERATOR_PASSWORD=
SIMULATOR_CATALOG_DIR=./simulator/local
SIMULATOR_INTERVAL_SECONDS=1
SIMULATOR_STEP_SECONDS=1

# InfluxDB usado pela aplicação
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=coldsafe
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=

# PostgreSQL relacional
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=coldsafe
POSTGRES_USER=coldsafe
POSTGRES_PASSWORD=

# Inicialização local do InfluxDB
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=
DOCKER_INFLUXDB_INIT_PASSWORD=
DOCKER_INFLUXDB_INIT_ORG=coldsafe
DOCKER_INFLUXDB_INIT_BUCKET=telemetry
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=

# Regras demonstrativas do domínio
TEMP_MIN_C=2
TEMP_MAX_C=8
ATTENTION_MARGIN_C=0.5
STALE_AFTER_SECONDS=30

# Frontend
# O build Docker usa a mesma origem pelo proxy. URL externa somente para Vite local.
VITE_API_BASE_URL=
VITE_POLL_INTERVAL_MS=5000
