# Aplicação
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# MQTT
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=coldsafe/v1/telemetry
MQTT_QOS=1
MQTT_CLIENT_ID=coldsafe-backend
MQTT_BACKEND_USERNAME=coldsafe-backend
MQTT_BACKEND_PASSWORD=
MQTT_DEVICE_USERNAME=coldsafe-device
MQTT_DEVICE_PASSWORD=

# InfluxDB usado pela aplicação
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=coldsafe
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=

# Inicialização local do InfluxDB
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=
DOCKER_INFLUXDB_INIT_PASSWORD=
DOCKER_INFLUXDB_INIT_ORG=coldsafe
DOCKER_INFLUXDB_INIT_BUCKET=telemetry
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=

# Regras demonstrativas do domínio
TEMP_MIN_C=2
TEMP_MAX_C=8
ATTENTION_MARGIN_C=0.5
STALE_AFTER_SECONDS=30

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_POLL_INTERVAL_MS=5000
