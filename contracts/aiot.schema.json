    "model_status_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version","event_id","type","occurred_at","received_at","device_id","device_record_id","environment_id","correlation_id","data"],
      "properties": {
        "schema_version": {"const":3},
